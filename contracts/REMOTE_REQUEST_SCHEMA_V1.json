{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation", "target_repo", "target_sha"],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "operation": {"const": "QNTY_SANDBOX_EXECUTION_SMOKE_V1"},
    "target_repo": {"const": "CipherCuttle/Qnty"},
    "target_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
  }
}
